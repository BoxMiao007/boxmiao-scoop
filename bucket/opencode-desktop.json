{
    "##": "checkver 使用 releases 页面而非 releases.atom：上游会先打 git tag 再发版，atom feed 会把仅有 tag、尚未发布的版本（如 v2.2.7）也列出来，导致 autoupdate 去下载 opencode.ai 上还不存在的二进制而 404。releases 页面只列已正式发布的版本。下载源 opencode.ai/files/bin/$version/ 与 GitHub release 资产是同一文件（v2.2.6 的 digest 与清单 hash 一致），且该域名比 GitHub release 下载稳定。",
    "version": "2.2.7",
    "description": "Desktop app for OpenCode, the open source AI coding agent",
    "homepage": "https://opencode.ai",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://opencode.ai/files/bin/2.2.7/opencode-desktop-win-x64.exe#/dl.7z",
            "hash": "2ea501f83e627bf2b1ba2afb5124391ab27c86b9dd5071324ea5cf8b168b7d2a",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\""
        }
    },
    "post_install": "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*.exe\" -Recurse -Force",
    "shortcuts": [
        [
            "OpenCode.exe",
            "OpenCode"
        ]
    ],
    "checkver": {
        "url": "https://github.com/anomalyco/opencode/releases",
        "regex": "releases/tag/v(2\\.[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://opencode.ai/files/bin/$version/opencode-desktop-win-x64.exe#/dl.7z"
            }
        }
    }
}
